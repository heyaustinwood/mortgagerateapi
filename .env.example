# Copy to .env for local development. Set the same values on your host in production.

# Where the site lives. Stripe redirects back here after checkout.
BASE_URL=http://127.0.0.1:5000

# Stripe: Developers > API keys, the Price ID of your subscription product,
# and the signing secret of the webhook pointed at $BASE_URL/stripe/webhook.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Shown on the page. Keep it in sync with the Stripe price.
PRICE_LABEL=$19/month
SUPPORT_EMAIL=support@mortgagerateapi.com

# Optional. Postgres (postgres://...) or leave unset for SQLite in ./instance/
# DATABASE_URL=

# 1 = pull fresh rates from FRED on startup and every 6 hours.
SYNC_IN_BACKGROUND=1
